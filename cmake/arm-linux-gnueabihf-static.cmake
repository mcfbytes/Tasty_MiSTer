set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
if(NOT TASTY_TOOLCHAIN_ROOT)
  set(TASTY_TOOLCHAIN_ROOT "$ENV{TASTY_TOOLCHAIN_ROOT}")
endif()
if(NOT TASTY_TOOLCHAIN_ROOT)
  message(FATAL_ERROR "set TASTY_TOOLCHAIN_ROOT to the Bootlin armv7 glibc toolchain")
endif()

list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES TASTY_TOOLCHAIN_ROOT TASTY_STATIC_DEPS)
set(CMAKE_C_COMPILER "${TASTY_TOOLCHAIN_ROOT}/bin/arm-buildroot-linux-gnueabihf-gcc")
set(CMAKE_CXX_COMPILER "${TASTY_TOOLCHAIN_ROOT}/bin/arm-buildroot-linux-gnueabihf-g++")
set(CMAKE_FIND_ROOT_PATH "${TASTY_TOOLCHAIN_ROOT}/arm-buildroot-linux-gnueabihf/sysroot")
if(NOT TASTY_STATIC_DEPS)
  set(TASTY_STATIC_DEPS "$ENV{TASTY_STATIC_DEPS}")
endif()
if(TASTY_STATIC_DEPS)
  list(APPEND CMAKE_FIND_ROOT_PATH "${TASTY_STATIC_DEPS}")
  set(ZLIB_INCLUDE_DIR "${TASTY_STATIC_DEPS}/include" CACHE PATH "static zlib headers")
  set(ZLIB_LIBRARY "${TASTY_STATIC_DEPS}/lib/libz.a" CACHE FILEPATH "static zlib")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)

set(CMAKE_EXE_LINKER_FLAGS_INIT "-static -static-libgcc -static-libstdc++")
add_compile_options(-mcpu=cortex-a9 -mfpu=neon-vfpv3 -mfloat-abi=hard -marm -D_TIME_BITS=64 -D_FILE_OFFSET_BITS=64)
set(CMAKE_POSITION_INDEPENDENT_CODE OFF)
