set(TASTY_SLINT_SDK "" CACHE PATH "Root of the pinned static Slint SDK (default: $ENV{TASTY_SLINT_SDK}, else /opt/slint/1.19.1)")
if(NOT TASTY_SLINT_SDK AND DEFINED ENV{TASTY_SLINT_SDK})
  set(TASTY_SLINT_SDK "$ENV{TASTY_SLINT_SDK}")
endif()
if(NOT TASTY_SLINT_SDK)
  set(TASTY_SLINT_SDK "/opt/slint/1.19.1")
endif()
if(NOT EXISTS "${TASTY_SLINT_SDK}/BUILD-INFO")
  message(FATAL_ERROR "no pinned Slint SDK at ${TASTY_SLINT_SDK} (no BUILD-INFO). Extract "
                      "slint-sdk-1.19.1-<n>.tar.zst (made by build-slint-sdk.sh) there, or pass -DTASTY_SLINT_SDK=<dir>. "
                      "The HD OSD is compiled into every build; there is no build without it.")
endif()

execute_process(COMMAND ${CMAKE_CXX_COMPILER} -dumpmachine
                OUTPUT_VARIABLE _tasty_machine OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _tasty_rc)
if(NOT _tasty_rc EQUAL 0)
  message(FATAL_ERROR "${CMAKE_CXX_COMPILER} -dumpmachine failed: cannot pick the Slint SDK triple")
endif()
if(_tasty_machine MATCHES "^arm.*gnueabihf")
  set(_tasty_slint_triple "armv7-linux-gnueabihf")
elseif(_tasty_machine MATCHES "^x86_64")
  set(_tasty_slint_triple "x86_64-linux-gnu")
elseif(_tasty_machine MATCHES "^aarch64")
  set(_tasty_slint_triple "aarch64-linux-gnu")
else()
  message(FATAL_ERROR "compiler triple '${_tasty_machine}' has no Slint SDK triple")
endif()
set(_tasty_slint_prefix "${TASTY_SLINT_SDK}/${_tasty_slint_triple}")
if(NOT EXISTS "${_tasty_slint_prefix}/lib/cmake/Slint/SlintConfig.cmake")
  message(FATAL_ERROR "the Slint SDK at ${TASTY_SLINT_SDK} carries no ${_tasty_slint_triple} (compiler '${_tasty_machine}'): "
                      "rebuild it with build-slint-sdk.sh")
endif()

file(STRINGS "${TASTY_SLINT_SDK}/BUILD-INFO" _tasty_info)
if(NOT "slint 1.19.1" IN_LIST _tasty_info)
  message(FATAL_ERROR "the Slint SDK at ${TASTY_SLINT_SDK} is not version 1.19.1 (BUILD-INFO: ${_tasty_info})")
endif()
foreach(_p 0001-api-cpp-dlopen-libfontconfig 0004-static-fontique 0005-optional-parley)
  if(NOT _tasty_info MATCHES "patch ${_p}")
    message(FATAL_ERROR "the Slint SDK at ${TASTY_SLINT_SDK} lacks patch ${_p}*: wrong patch set")
  endif()
endforeach()

file(GLOB _tasty_shared "${_tasty_slint_prefix}/lib/libslint*.so*")
if(_tasty_shared)
  message(FATAL_ERROR "the Slint SDK carries a shared library (${_tasty_shared}): the HD OSD links the static archive only")
endif()
if(NOT EXISTS "${_tasty_slint_prefix}/lib/libslint_cpp.a")
  message(FATAL_ERROR "the Slint SDK carries no ${_tasty_slint_prefix}/lib/libslint_cpp.a")
endif()

set(Slint_DIR "${_tasty_slint_prefix}/lib/cmake/Slint" CACHE PATH "static Slint package" FORCE)
set(SLINT_COMPILER "${TASTY_SLINT_SDK}/bin/slint-compiler" CACHE FILEPATH "pinned slint-compiler" FORCE)
message(STATUS "Slint SDK: ${TASTY_SLINT_SDK} (${_tasty_slint_triple})")

function(tasty_slint_assert_static)
  if(NOT TARGET slint_cpp-static)
    message(FATAL_ERROR "find_package(Slint) did not yield the static slint_cpp-static target")
  endif()
  get_target_property(_loc slint_cpp-static IMPORTED_LOCATION)
  if(NOT _loc MATCHES "^${TASTY_SLINT_SDK}/.*\\.a$")
    message(FATAL_ERROR "Slint resolves to '${_loc}', not the static archive under ${TASTY_SLINT_SDK}")
  endif()
endfunction()
